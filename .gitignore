node_modules/
dist/
*.log

# Artifacts of running the thing, in the repo root because that is where the
# defaults put them. TRICORDER_DB defaults to ./tricorder.db, TWIKI_AUDIT_PATH
# to ./audit.jsonl, and `make pack` writes the tarball beside them.
audit.jsonl
.twiki-last-digest*
tricorder.db
tricorder.db-shm
tricorder.db-wal
twiki-*.tgz

# Secrets — never commit
.env
.env.*
# ...except the template, which carries no values (see compose.yml).
!.env.example
*.pem
github-app-private-key*

# AI tools
_bmad-output/
_bmad/
openspec-output/
openspec/
.claude/

# Local config (see repos.example.yaml)
/repos.yaml

# IDE
.idea/
.vscode/

# Branding images, kept out of git deliberately: 3.6MB of binaries would sit in
# every clone forever, and git has no way to forget them later without a history
# rewrite. Resize and commit a small one if the README needs it, or move them to
# LFS. Removing this line is a decision, not a formality.
assets/
