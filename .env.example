#
# Copy to .env and edit. Compose reads .env automatically; it is gitignored.
# Full descriptions of every variable live in the README's env tables.

# Image to run. Defaults to the published one.
#
# To run what `make image` just built locally, set BOTH: that target tags
# $(IMAGE):$(TAG) with the Makefile's own defaults, which are `twiki:dev`.
# Changing only TAG here leaves IMAGE pointing at ghcr.io, and compose then
# fails trying to pull a tag that only exists on your machine.
#
#   IMAGE=twiki
#   TAG=dev
IMAGE=ghcr.io/no42-org/twiki
TAG=latest

# --- twiki (the write side) -------------------------------------------------
TWIKI_GITHUB_APP_ID=
TWIKI_KEY_PATH=./twiki.pem
# Start in shadow. Flip to enforce once you trust the digests.
TWIKI_MODE=shadow
TWIKI_POLL_MINUTES=60
TWIKI_SLACK_WEBHOOK_URL=
ANTHROPIC_API_KEY=

# --- gitricorder (the read side) --------------------------------------------
# A SEPARATE App from twiki's, read-only by construction (AD-21). Sharing one
# credential would give the dashboard the ability to write, which is the single
# thing its design rules out.
TRICORDER_GITHUB_APP_ID=
TRICORDER_KEY_PATH=./tricorder.pem
TRICORDER_TICK_SECONDS=60

# The dashboard is published on 127.0.0.1 only. There is no authentication in
# front of it; changing that binding exposes every collected alert.
TRICORDER_PORT=8787
