{
  // The browser project only: page.evaluate callbacks read the DOM, and
  // this is the one program with the DOM lib. The root program excludes
  // this directory, so src/ is still checked without DOM globals.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "noEmit": true
  },
  "include": ["./**/*.ts", "./**/*.tsx"],
  "exclude": ["node_modules"]
}
