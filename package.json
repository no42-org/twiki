{
  "name": "twiki",
  "version": "0.1.0",
  "description": "Autonomous Dependabot/Security PR manager: merges green PRs within policy, batch-cuts patch releases, reports to chat. Safe by construction.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "twiki": "dist/index.js",
    "tricorder": "dist/tricorder.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/browser/tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "start:tricorder-collect": "node --disable-warning=ExperimentalWarning dist/tricorder.js collect",
    "start:tricorder-web": "node --disable-warning=ExperimentalWarning dist/tricorder.js web",
    "dev:tricorder": "tsx src/tricorder.ts"
  },
  "license": "MIT",
  "author": "Ronny Trommer <ronny@no42.org>",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@hono/node-server": "^2.1.1",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/graphql": "^9.0.5",
    "@octokit/rest": "^22.0.1",
    "hono": "^4.13.7",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@octokit/openapi-types": "29.0.1",
    "@types/node": "^24.13.3",
    "playwright": "1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
