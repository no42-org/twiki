{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/core/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/twiki/**",
                      "**/tricorder/**",
                      "**/tricorder.ts",
                      "**/github/**",
                      "**/enrich/**"
                    ],
                    "message": "AD-5: leaves are peers. core is innermost; github and enrich may use core but not each other."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/github/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/twiki/**",
                      "**/tricorder/**",
                      "**/tricorder.ts",
                      "**/enrich/**"
                    ],
                    "message": "AD-5: leaves are peers. core is innermost; github and enrich may use core but not each other."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/enrich/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/twiki/**",
                      "**/tricorder/**",
                      "**/tricorder.ts",
                      "**/github/**"
                    ],
                    "message": "AD-5: leaves are peers. core is innermost; github and enrich may use core but not each other."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/twiki/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/tricorder/**", "**/tricorder.ts"],
                    "message": "AD-5: this directory may not import a feature directory. Move shared code down into a leaf."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/tricorder/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/twiki/**"],
                    "message": "AD-5: this directory may not import a feature directory. Move shared code down into a leaf."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/index.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/tricorder/**", "**/tricorder.ts"],
                    "message": "AD-5: an entrypoint wires exactly one side. src/index.ts is twiki's, src/tricorder.ts is gitricorder's."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/tricorder.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/twiki/**"],
                    "message": "AD-5: an entrypoint wires exactly one side. src/index.ts is twiki's, src/tricorder.ts is gitricorder's."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["test/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
