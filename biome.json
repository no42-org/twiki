{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/core/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/twiki/**",
                      "**/tricorder/**",
                      "**/github/**",
                      "**/enrich/**"
                    ],
                    "message": "AD-5: leaf directory. It may import node: builtins, packages and its own files. Move shared code down, never import a feature directory."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/github/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/twiki/**", "**/tricorder/**"],
                    "message": "AD-5: leaf directory. It may import node: builtins, packages and its own files. Move shared code down, never import a feature directory."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/enrich/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/twiki/**", "**/tricorder/**"],
                    "message": "AD-5: leaf directory. It may import node: builtins, packages and its own files. Move shared code down, never import a feature directory."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/twiki/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/tricorder/**"],
                    "message": "AD-5: src/twiki and src/tricorder are siblings and neither may import the other. Move shared code down into a leaf."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/tricorder/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/twiki/**"],
                    "message": "AD-5: src/twiki and src/tricorder are siblings and neither may import the other. Move shared code down into a leaf."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["test/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
