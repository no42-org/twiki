{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "test/**/*.ts",
      "test/**/*.tsx",
      "scripts/**/*.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/core/**/*.ts", "src/core/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/twiki/**",
                      "**/tricorder/**",
                      "**/github/**",
                      "**/enrich/**"
                    ],
                    "message": "AD-5: leaves are peers. core is innermost; github and enrich may use core but not each other."
                  },
                  {
                    "group": ["**/index.js", "**/tricorder.js"],
                    "message": "AD-5: nothing imports an entrypoint. An entrypoint wires one side; importing it drags that whole side in behind the boundary."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/github/**/*.ts", "src/github/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/twiki/**", "**/tricorder/**", "**/enrich/**"],
                    "message": "AD-5: leaves are peers. core is innermost; github and enrich may use core but not each other."
                  },
                  {
                    "group": ["**/index.js", "**/tricorder.js"],
                    "message": "AD-5: nothing imports an entrypoint. An entrypoint wires one side; importing it drags that whole side in behind the boundary."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/enrich/**/*.ts", "src/enrich/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/twiki/**", "**/tricorder/**", "**/github/**"],
                    "message": "AD-5: leaves are peers. core is innermost; github and enrich may use core but not each other."
                  },
                  {
                    "group": ["**/index.js", "**/tricorder.js"],
                    "message": "AD-5: nothing imports an entrypoint. An entrypoint wires one side; importing it drags that whole side in behind the boundary."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/twiki/**/*.ts", "src/twiki/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/tricorder/**"],
                    "message": "AD-5: this directory may not import a feature directory. Move shared code down into a leaf."
                  },
                  {
                    "group": ["**/index.js", "**/tricorder.js"],
                    "message": "AD-5: nothing imports an entrypoint. An entrypoint wires one side; importing it drags that whole side in behind the boundary."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/tricorder/**/*.ts", "src/tricorder/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/twiki/**"],
                    "message": "AD-5: this directory may not import a feature directory. Move shared code down into a leaf."
                  },
                  {
                    "group": ["**/index.js", "**/tricorder.js"],
                    "message": "AD-5: nothing imports an entrypoint. An entrypoint wires one side; importing it drags that whole side in behind the boundary."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/index.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/tricorder/**", "**/tricorder.js"],
                    "message": "AD-5: an entrypoint wires exactly one side. src/index.ts is twiki's, src/tricorder.ts is gitricorder's."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/tricorder.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/twiki/**", "**/index.js"],
                    "message": "AD-5: an entrypoint wires exactly one side. src/index.ts is twiki's, src/tricorder.ts is gitricorder's."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["test/**/*.ts", "test/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
